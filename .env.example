# metaRechnung (Docker) – Kopie als ".env" speichern und ausfüllen.
# Die Werte mit (*) werden nur bei der ERST-Einrichtung gelesen; danach ändert man alles in den Einstellungen der App.
# Die Datei enthält Geheimnisse – nicht einchecken, nicht weitergeben.

# --- Datenbank (frei wählbares, langes Passwort) ---
DB_PASS=

# --- Zugang (*) ---
ADMIN_USER=admin
# mindestens 10 Zeichen; gespeichert wird nur der Hash
ADMIN_PASSWORD=

# --- Firma (*) ---
COMPANY_NAME=
COMPANY_OWNER=
COMPANY_STREET=
COMPANY_ZIP=
COMPANY_CITY=
COMPANY_COUNTRY=DE
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_TAX_NUMBER=
COMPANY_VAT_ID=
COMPANY_IBAN=
COMPANY_BIC=
COMPANY_BANK=
KLEINUNTERNEHMER=0

# --- Öffentliche Adresse (*), für Links in Mails und QR-Codes, ohne Pfad ---
APP_URL=http://localhost:8080

# --- E-Mail-Versand (*, optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Betrieb ---
# Port/Adresse auf dem Host. Standard: nur lokal (127.0.0.1). Für direkten Zugriff aus dem Netz: HTTP_BIND=0.0.0.0
HTTP_PORT=8080
HTTP_BIND=127.0.0.1
# Steht ein Reverse-Proxy davor, hier dessen Adresse/Netz eintragen, damit Sperren (Login, Cron) die echte Client-IP nutzen
# z. B. Docker-Standardnetz: 172.16.0.0/12  (nur eintragen, wenn der Proxy X-Forwarded-For selbst setzt!)
TRUSTED_PROXIES=
# Image-Version, z. B. 1.20.0 (Standard: latest)
METARECHNUNG_TAG=latest
